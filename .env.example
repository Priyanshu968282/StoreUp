# Apna Bazaar environment configuration
# Copy this file to `.env` and fill in the real key.

# Your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Live voice+camera model. MUST be a Live-capable model.
# gemini-3.5-flash does NOT support the Live API.
LIVE_MODEL=gemini-3.1-flash-live-preview

# Managed Agent (Interactions API). Verify at hackathon; falls back safely.
AGENT_ID=antigravity-preview-05-2026

# Fallback model for Beckn JSON if the Managed Agent is unavailable.
AGENT_MODEL=gemini-3.5-flash

# How the Beckn catalog is built on publish. "deterministic" = instant + always
# valid (use for the live demo). Set to "auto" to showcase the Managed Agent
# path (Managed Agent -> model self-correct -> deterministic fallback).
BECKN_MODE=deterministic

# Nano Banana 2 Lite product images for the buyer app (generated in the
# background, cached, emoji fallback). Set ENABLE_PRODUCT_IMAGES=false to disable.
IMAGE_MODEL=gemini-3.1-flash-lite-image
ENABLE_PRODUCT_IMAGES=true
